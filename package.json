{
  "name": "electron-vue-vite",
  "version": "28.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "草鞋没号 <308487730@qq.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 && vite",
    "build": "chcp 65001 && vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.13.2",
    "cross-env": "^7.0.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.0.12",
    "lodash": "^4.17.21",
    "rimraf": "^4.1.2",
    "pinia": "^3.0.4",
    "sass": "^1.96.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.7",
    "adm-zip": "^0.5.16",
    "chardet": "^2.1.0",
    "electron-icon-builder": "^2.0.1",
    "fuse.js": "^6.6.2",
    "iconv-lite": "^0.6.3",
    "music-metadata": "11.12.3",
    "node-id3": "^0.2.9",
    "node-smb2": "^1.3.3",
    "pidusage": "^4.0.1",
    "webdav": "^5.8.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue-i18n": "^11.2.2"
  }
}
